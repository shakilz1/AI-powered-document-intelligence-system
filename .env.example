# Copy to backend/.env or export in your shell. All values are optional.

# --- AI extraction (Claude). Without a key the system uses the rule-based extractor. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5        # e.g. claude-haiku-5-5 for much cheaper bulk extraction
LLM_EFFORT=low                   # low|medium|high — extraction is a simple task
LLM_CONCURRENCY=4                # parallel LLM calls per document (1000-page PDFs)
LLM_VISION=true                  # photos/scans: send the page image to Claude (reads handwriting)
LLM_MAX_IMAGES=8                 # max pages per vision call

# --- FREE alternative: Google Gemini (key from https://aistudio.google.com/apikey, no card needed) ---
# Used when GEMINI_API_KEY is set and ANTHROPIC_API_KEY is not (or LLM_PROVIDER=gemini).
# Free-tier note: Google may use free-tier inputs to improve its products - don't send confidential files.
GEMINI_API_KEY=
LLM_PROVIDER=auto                # auto | anthropic | gemini | ollama
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used when the main model's free quota runs out
GEMINI_TEXT=false                # false = only photos/scans go to Gemini (saves the small free quota)

# --- LOCAL option: Ollama (https://ollama.com). No key, no quota, documents never leave this machine. ---
# Install Ollama, run `ollama pull qwen3.5:4b`, then set LLM_PROVIDER=ollama (overrides any cloud key).
# OLLAMA_MODEL=qwen3.5:4b          # any Ollama model; vision needs a vision-capable one (qwen3.5 has it)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TEXT=true                 # also send typed PDFs/spreadsheets to the local model
# OLLAMA_TIMEOUT=600               # seconds per call (CPU-only inference is slow)
# OLLAMA_NUM_CTX=16384             # context window; raise for long multi-page segments
# OLLAMA_THINK=false               # model "thinking" mode: slower, rarely helps extraction

# --- HYBRID: a different provider for photos/scans/handwriting only ---
# e.g. local Ollama for typed documents + Gemini for photos (small local models misread handwriting).
# Empty = photos use LLM_PROVIDER too. If the vision call fails, the photo falls back to the text model.
# VISION_PROVIDER=gemini            # anthropic | gemini | ollama

# --- Database. SQLite by default; PostgreSQL for production. ---
# DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
STORAGE_DIR=./data/uploads

# --- Security ---
API_KEY=                         # if set, every /api request needs header X-API-Key
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=200
MAX_FILES_PER_REQUEST=50

# --- Workers / OCR ---
WORKER_MODE=process              # process (CPU-bound OCR) | thread
WORKER_THREADS=4                 # parallel documents
OCR_THREADS=0                    # 0 = cpu_count / WORKER_THREADS
OCR_DPI=200
OCR_LOW_CONFIDENCE=0.80

# --- Search ---
EMBEDDING_BACKEND=auto           # auto | hashing | fastembed
